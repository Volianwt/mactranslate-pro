AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
OPENAI_API_KEY=your_openai_api_key_here
# Optional, used for dictionary-grade click-to-pronounce lookup.
# Merriam-Webster allows up to two free non-commercial reference APIs under its free terms.
MW_MEDICAL_API_KEY=your_merriam_webster_medical_key_here
MW_COLLEGIATE_API_KEY=your_merriam_webster_collegiate_key_here
# Optional: Azure TTS voice used when no dictionary audio exists.
AZURE_TTS_VOICE=en-US-JennyNeural
# Optional: OpenAI TTS fallback used before Azure TTS when no dictionary audio exists.
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=marin
DASHSCOPE_API_KEY=your_dashscope_api_key_here
SONIOX_API_KEY=your_soniox_api_key_here
# Optional: force mainland China endpoint instead of international/Singapore.
# DASHSCOPE_REGION=cn
# Optional: override Soniox realtime WebSocket base URL.
# SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
